# ==========================================
# APP & SECURITY CONFIGURATION
# ==========================================
PROJECT_NAME="Quizz App Backend"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=15
FRONTEND_URL="http://localhost:5173"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ==========================================
# DATABASE & CACHE CONFIGURATION
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quizz_db"
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# GOOGLE GEMINI AI & RAG CHATBOT
# ==========================================
# Get Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# (Optional) OpenRouter Fallback Key: https://openrouter.ai/
OPENROUTER_API_KEY="your-openrouter-api-key-here"

ASSISTANT_NAME="Quizzy"

# ==========================================
# SMTP EMAIL CONFIGURATION
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="your-email@example.com"
EMAILS_FROM_NAME="QuizzApp Support"

# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
